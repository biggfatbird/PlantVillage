        "\n",
        "# Proxy groups: same recorded conditions, allowing time to vary.\n",
        "# This keeps related time-series rows together.\n",
        "# These are NOT verified publication/study identifiers.\n",
        "group_columns = [c for c in features if c != \"time_min\"]\n",
        "group_index = pd.MultiIndex.from_frame(df[group_columns])\n",
        "df[\"condition_group\"] = pd.factorize(group_index)[0]\n",
        "\n",
        "df.to_csv(OUT / \"cleaned_dataset.csv\", index=False)\n",
        "\n",
        "audit = {\n",
