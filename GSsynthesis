        "\n",
        "parts = []\n",
        "for filename in [\n",
        "    \"Adsorption and regeneration data_1007c.xlsx\",\n",
        "    \"Dyes data.xlsx\",\n",
        "]:\n",
        "    frame = pd.read_excel(filename, sheet_name=0)\n",
        "    frame = frame[list(mapping)].rename(columns=mapping)\n",
        "    frame[\"source_file\"] = filename\n",
        "    frame[\"excel_row\"] = np.arange(2, len(frame) + 2)\n",
        "    parts.append(frame)\n",
        "\n",
        "raw = pd.concat(parts, ignore_index=True)\n",
        "raw.to_csv(OUT / \"selected_raw_records.csv\", index=False)\n",
        "\n",
        "target = \"capacity_mg_g\"\n",
        "features = [c for c in mapping.values() if c != target]\n",
        "categorical = [\"adsorbent\", \"dye\"]\n",
        "numerical = [c for c in features if c not in categorical]\n",
        "\n",
        "for col in numerical + [target]:\n",
        "    raw[col] = pd.to_numeric(raw[col], errors=\"coerce\")\n",
        "\n",
        "for col in categorical:\n",
        "    raw[col] = raw[col].astype(\"string\").str.strip()\n",
        "    raw[col] = raw[col].replace(\"\", pd.NA)\n",
        "\n",
        "raw[features + [target]].isna().sum().rename(\n",
        "    \"missing_or_invalid\"\n",
        ").to_csv(OUT / \"missing_values.csv\")\n",
        "\n",
        "incomplete = raw[features + [target]].isna().any(axis=1)\n",
        "excluded = raw.loc[incomplete].copy()\n",
        "excluded[\"exclusion_reason\"] = \"Missing or invalid required value\"\n",
        "excluded.to_csv(OUT / \"excluded_incomplete_records.csv\", index=False)\n",
        "\n",
        "complete = raw.loc[~incomplete].copy()\n",
        "duplicate = complete.duplicated(subset=features + [target])\n",
        "complete.loc[duplicate].to_csv(\n",
        "    OUT / \"duplicate_records.csv\", index=False\n",
        ")\n",
        "\n",
        "# Preserve duplicates separately; do not count them as extra evidence.\n",
        "df = complete.loc[~duplicate].copy().reset_index(drop=True)\n",
        "df[\"record_id\"] = np.arange(1, len(df) + 1)\n",
        "\n",
        "assert np.isfinite(df[numerical + [target]].to_numpy()).all()\n",
        "assert (df[\"adsorbent_mass_g\"] > 0).all()\n",
