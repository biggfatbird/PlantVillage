        "from sklearn.model_selection import GridSearchCV\n",
        "from sklearn.metrics import (\n",
        "    mean_absolute_error, mean_squared_error, r2_score\n",
        ")\n",
        "from sklearn.inspection import permutation_importance\n",
        "import joblib\n",
        "\n",
        "# Pick the non-baseline candidate using TRAINING CV only.\n",
        "best_name = comparison.loc[\n",
        "    comparison.model != \"Mean baseline\", \"model\"\n",
        "].iloc[0]\n",
        "\n",
        "grids = {\n",
        "    \"Ridge\": {\"model__alpha\": [0.1, 1, 10, 100, 1000]},\n",
        "    \"SVR\": {\n",
        "        \"model__C\": [10, 100, 1000],\n",
        "        \"model__epsilon\": [0.1, 1, 10],\n",
        "    },\n",
        "    \"Random forest\": {\n",
        "        \"model__max_depth\": [None, 8, 16],\n",
        "        \"model__min_samples_leaf\": [1, 3, 5],\n",
        "    },\n",
        "    \"Extra trees\": {\n",
        "        \"model__max_depth\": [None, 8, 16],\n",
        "        \"model__min_samples_leaf\": [1, 3, 5],\n",
        "    },\n",
        "    \"Gradient boosting\": {\n",
        "        \"model__n_estimators\": [100, 200],\n",
        "        \"model__max_depth\": [2, 3],\n",
        "        \"model__learning_rate\": [0.03, 0.1],\n",
        "    },\n",
        "}\n",
        "\n",
        "search = GridSearchCV(\n",
        "    pipelines[best_name],\n",
        "    grids[best_name],\n",
        "    scoring=\"neg_mean_absolute_error\",\n",
        "    cv=cv, n_jobs=-1, refit=True,\n",
        "    error_score=\"raise\"\n",
        ")\n",
        "search.fit(X_train, y_train, groups=g_train)\n",
        "\n",
        "pd.DataFrame(search.cv_results_).to_csv(\n",
        "    OUT / \"tuning_results.csv\", index=False\n",
        ")\n",
        "with open(OUT / \"selected_parameters.json\", \"w\") as f:\n",
        "    json.dump({\n",
        "        \"model\": best_name,\n",
        "        \"parameters\": search.best_params_,\n",
        "        \"selection\": \"Training grouped cross-validation MAE\",\n",
        "    }, f, indent=2)\n",
        "\n",
        "# Final test evaluation: selected model versus baseline.\n",
        "final_model = search.best_estimator_\n",
        "prediction = final_model.predict(X_test)\n",
        "\n",
        "baseline = DummyRegressor(strategy=\"mean\")\n",
        "baseline.fit(np.zeros((len(y_train), 1)), y_train)\n",
        "baseline_prediction = baseline.predict(\n",
        "    np.zeros((len(y_test), 1))\n",
        ")\n",
        "\n",
        "def metrics(observed, predicted):\n",
        "    return {\n",
        "        \"MAE_mg_g\": mean_absolute_error(observed, predicted),\n",
        "        \"RMSE_mg_g\": np.sqrt(mean_squared_error(observed, predicted)),\n",
        "        \"R2\": r2_score(observed, predicted)\n",
        "    }\n",
        "\n",
        "test_results = pd.DataFrame([\n",
        "    {\"model\": \"Mean baseline\",\n",
        "     **metrics(y_test, baseline_prediction)},\n",
        "    {\"model\": f\"Tuned {best_name}\",\n",
        "     **metrics(y_test, prediction)},\n",
        "])\n",
        "test_results.to_csv(OUT / \"final_test_metrics.csv\", index=False)\n",
        "display(test_results)\n",
        "print(\"Selected parameters:\", search.best_params_)\n",
        "\n",
        "predictions = df.iloc[test_idx][[\n",
        "    \"record_id\", \"adsorbent\", \"dye\", \"condition_group\"\n",
        "]].copy()\n",
        "predictions[\"measured_mg_g\"] = y_test.to_numpy()\n",
        "predictions[\"predicted_mg_g\"] = prediction\n",
        "predictions[\"residual_mg_g\"] = prediction - y_test.to_numpy()\n",
        "predictions.to_csv(OUT / \"test_predictions.csv\", index=False)\n",
        "\n",
        "fig, axes = plt.subplots(1, 2, figsize=(11, 4))\n",
        "axes[0].scatter(y_test, prediction, alpha=0.55, s=22)\n",
        "lo = min(y_test.min(), prediction.min())\n",
        "hi = max(y_test.max(), prediction.max())\n",
        "axes[0].plot([lo, hi], [lo, hi], \"k--\")\n",
        "axes[0].set_xlabel(\"Measured capacity (mg/g)\")\n",
        "axes[0].set_ylabel(\"Predicted capacity (mg/g)\")\n",
        "\n",
        "axes[1].scatter(prediction, prediction - y_test, alpha=0.55, s=22)\n",
        "axes[1].axhline(0, color=\"black\", linestyle=\"--\")\n",
        "axes[1].set_xlabel(\"Predicted capacity (mg/g)\")\n",
        "axes[1].set_ylabel(\"Predicted minus measured (mg/g)\")\n",
        "save_figure(\"08_final_test_predictions_residuals\")\n",
        "\n",
        "# Exploratory diagnostic only; do not retune after inspecting test errors.\n",
        "importance = permutation_importance(\n",
        "    final_model, X_test, y_test,\n",
        "    scoring=\"neg_mean_absolute_error\",\n",
        "    n_repeats=5, random_state=42, n_jobs=-1\n",
        ")\n",
        "importance_table = pd.DataFrame({\n",
        "    \"feature\": features,\n",
        "    \"MAE_increase\": importance.importances_mean,\n",
        "    \"SD\": importance.importances_std,\n",
        "}).sort_values(\"MAE_increase\")\n",
        "importance_table.to_csv(\n",
        "    OUT / \"permutation_importance.csv\", index=False\n",
        ")\n",
        "\n",
        "plt.figure(figsize=(9, 6))\n",
        "plt.barh(\n",
        "    importance_table.feature,\n",
        "    importance_table.MAE_increase,\n",
        "    xerr=importance_table.SD,\n",
        "    color=\"slateblue\"\n",
        ")\n",
        "plt.xlabel(\"Increase in test MAE after permutation (mg/g)\")\n",
        "save_figure(\"09_permutation_importance\")\n",
        "\n",
        "joblib.dump(final_model, OUT / \"selected_model.joblib\")\n",
        "with open(OUT / \"environment.json\", \"w\") as f:\n",
        "    json.dump({\n",
        "        \"python\": platform.python_version(),\n",
        "        \"sklearn\": sklearn.__version__,\n",
        "        \"pandas\": pd.__version__,\n",
        "        \"numpy\": np.__version__,\n",
        "    }, f, indent=2)\n",
        "\n",
        "shutil.make_archive(\"/content/pbl_results\", \"zip\", OUT)\n",
        "files.download(\"/content/pbl_results.zip\")"
