        "from sklearn.model_selection import (\n",
        "    GroupShuffleSplit, GroupKFold, cross_validate\n",
        ")\n",
        "from sklearn.compose import ColumnTransformer\n",
        "from sklearn.pipeline import Pipeline\n",
        "from sklearn.preprocessing import StandardScaler, OneHotEncoder\n",
        "from sklearn.dummy import DummyRegressor\n",
        "from sklearn.linear_model import Ridge\n",
        "from sklearn.svm import SVR\n",
        "from sklearn.ensemble import (\n",
        "    RandomForestRegressor, ExtraTreesRegressor,\n",
        "    GradientBoostingRegressor\n",
        ")\n",
        "\n",
        "X = df[features].copy()\n",
        "y = df[target].copy()\n",
        "groups = df[\"condition_group\"]\n",
        "\n",
        "splitter = GroupShuffleSplit(\n",
        "    n_splits=1, test_size=0.20, random_state=42\n",
        ")\n",
        "train_idx, test_idx = next(splitter.split(X, y, groups))\n",
        "\n",
        "X_train, X_test = X.iloc[train_idx], X.iloc[test_idx]\n",
        "y_train, y_test = y.iloc[train_idx], y.iloc[test_idx]\n",
        "g_train, g_test = groups.iloc[train_idx], groups.iloc[test_idx]\n",
        "\n",
        "assert set(g_train).isdisjoint(set(g_test))\n",
        "\n",
        "assignments = df[[\n",
        "    \"record_id\", \"source_file\", \"excel_row\", \"condition_group\"\n",
        "]].copy()\n",
        "assignments[\"split\"] = \"train\"\n",
        "assignments.loc[test_idx, \"split\"] = \"test\"\n",
        "assignments.to_csv(OUT / \"split_assignments.csv\", index=False)\n",
        "\n",
        "print(\"Training rows:\", len(train_idx))\n",
        "print(\"Test rows:\", len(test_idx))\n",
        "print(\"Training groups:\", g_train.nunique())\n",
        "print(\"Test groups:\", g_test.nunique())\n",
        "\n",
        "def preprocessing():\n",
        "    return ColumnTransformer([\n",
        "        (\"numeric\", StandardScaler(), numerical),\n",
        "        (\"categorical\", OneHotEncoder(\n",
        "            handle_unknown=\"ignore\", sparse_output=False\n",
        "        ), categorical),\n",
        "    ])\n",
        "\n",
        "models = {\n",
        "    \"Mean baseline\": DummyRegressor(strategy=\"mean\"),\n",
        "    \"Ridge\": Ridge(alpha=10),\n",
        "    \"SVR\": SVR(C=100, epsilon=1, kernel=\"rbf\"),\n",
        "    \"Random forest\": RandomForestRegressor(\n",
        "        n_estimators=300, min_samples_leaf=3,\n",
        "        random_state=42, n_jobs=1\n",
        "    ),\n",
        "    \"Extra trees\": ExtraTreesRegressor(\n",
        "        n_estimators=300, min_samples_leaf=3,\n",
        "        random_state=42, n_jobs=1\n",
        "    ),\n",
        "    \"Gradient boosting\": GradientBoostingRegressor(\n",
        "        n_estimators=200, learning_rate=0.05,\n",
        "        max_depth=2, random_state=42\n",
        "    ),\n",
        "}\n",
        "\n",
        "cv = GroupKFold(n_splits=5)\n",
        "scoring = {\n",
        "    \"MAE\": \"neg_mean_absolute_error\",\n",
        "    \"RMSE\": \"neg_root_mean_squared_error\",\n",
        "    \"R2\": \"r2\",\n",
        "}\n",
        "\n",
        "pipelines, rows, fold_rows = {}, [], []\n",
        "\n",
        "for name, estimator in models.items():\n",
        "    pipe = Pipeline([\n",
        "        (\"preprocess\", preprocessing()),\n",
        "        (\"model\", estimator)\n",
        "    ])\n",
        "    pipelines[name] = pipe\n",
        "\n",
        "    result = cross_validate(\n",
        "        pipe, X_train, y_train,\n",
        "        groups=g_train, cv=cv, scoring=scoring,\n",
        "        return_train_score=True, n_jobs=-1,\n",
        "        error_score=\"raise\"\n",
        "    )\n",
        "\n",
        "    rows.append({\n",
        "        \"model\": name,\n",
        "        \"CV_MAE\": -result[\"test_MAE\"].mean(),\n",
        "        \"CV_MAE_SD\": result[\"test_MAE\"].std(ddof=1),\n",
        "        \"CV_RMSE\": -result[\"test_RMSE\"].mean(),\n",
        "        \"CV_R2\": result[\"test_R2\"].mean(),\n",
        "        \"training_MAE\": -result[\"train_MAE\"].mean(),\n",
        "    })\n",
        "\n",
        "    for fold in range(5):\n",
        "        fold_rows.append({\n",
        "            \"model\": name, \"fold\": fold + 1,\n",
        "            \"MAE\": -result[\"test_MAE\"][fold],\n",
        "            \"RMSE\": -result[\"test_RMSE\"][fold],\n",
        "            \"R2\": result[\"test_R2\"][fold],\n",
        "        })\n",
        "    print(\"Completed:\", name)\n",
        "\n",
        "comparison = pd.DataFrame(rows).sort_values(\"CV_MAE\")\n",
        "comparison.to_csv(OUT / \"model_comparison_cv.csv\", index=False)\n",
        "pd.DataFrame(fold_rows).to_csv(\n",
        "    OUT / \"individual_fold_scores.csv\", index=False\n",
        ")\n",
        "display(comparison)\n",
        "\n",
        "plt.figure(figsize=(9, 5))\n",
        "plt.barh(comparison.model, comparison.CV_MAE, color=\"teal\")\n",
        "plt.xlabel(\"Mean grouped-validation MAE (mg/g)\")\n",
        "plt.gca().invert_yaxis()\n",
        "save_figure(\"06_model_comparison\")\n",
        "\n",
        "plt.figure(figsize=(9, 5))\n",
        "positions = np.arange(len(comparison))\n",
        "plt.bar(\n",
        "    positions - 0.2, comparison.training_MAE,\n",
        "    width=0.4, label=\"Training\"\n",
        ")\n",
        "plt.bar(\n",
        "    positions + 0.2, comparison.CV_MAE,\n",
        "    width=0.4, label=\"Grouped validation\"\n",
        ")\n",
        "plt.xticks(positions, comparison.model, rotation=30, ha=\"right\")\n",
        "plt.ylabel(\"MAE (mg/g)\")\n",
        "plt.legend()\n",
        "save_figure(\"07_training_validation_errors\")"
      ],
